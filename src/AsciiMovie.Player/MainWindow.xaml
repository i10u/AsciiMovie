<Window x:Class="AsciiMovie.Player.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AsciiMovie Player" Height="800" Width="1200"
        MinHeight="500" MinWidth="900"
        Background="Black">
    <Window.InputBindings>
        <KeyBinding Key="C" Modifiers="Control" Command="ApplicationCommands.Copy"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Copy" Executed="Copy_Executed" CanExecute="Copy_CanExecute"/>
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="#222" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,2">
                <Button Content="開く" Click="Open_Click" Margin="4,2" Padding="8,4" ToolTip=".amov または MP4 等"/>
                <Button x:Name="PlayPauseButton" Content="再生" Click="PlayPause_Click" Margin="4,2" Padding="8,4"/>
                <Button Content="停止" Click="Stop_Click" Margin="4,2" Padding="8,4"/>
            </StackPanel>
            <Menu Background="Transparent">
                <MenuItem Header="ファイル(_F)">
                    <MenuItem Header="ファイルを開く (.amov / 動画)(_O)..." Click="Open_Click"/>
                    <Separator/>
                    <MenuItem Header="終了(_X)" Click="Exit_Click"/>
                </MenuItem>
                <MenuItem Header="再生(_P)">
                    <MenuItem Header="再生 / 一時停止(_P)" Click="PlayPause_Click"/>
                    <MenuItem Header="停止(_S)" Click="Stop_Click"/>
                </MenuItem>
                <MenuItem Header="編集(_E)">
                    <MenuItem Header="コピー(_C)" Command="ApplicationCommands.Copy"/>
                </MenuItem>
            </Menu>
        </DockPanel>

        <Grid Grid.Row="1" Margin="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="300" MinWidth="260" MaxWidth="360"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="Black" BorderBrush="#333" BorderThickness="1">
                <Grid>
                    <RichTextBox x:Name="FrameEditor"
                                 IsReadOnly="True"
                                 IsDocumentEnabled="True"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Background="Black"
                                 Foreground="White"
                                 BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Focusable="True"/>
                    <TextBlock x:Name="SelectionHint"
                               Text="一時停止中: ドラッグで矩形選択 / Ctrl+C でコピー"
                               Foreground="#888"
                               FontSize="11"
                               Margin="8"
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Left"
                               Visibility="Collapsed"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="#333" ShowsPreview="True"/>

            <Border Grid.Column="2" Background="#111" BorderBrush="#333" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">
                        <TextBlock Text="表示・プレビュー設定" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <TextBlock Text="解像度 cols" Foreground="#CCC" Margin="0,0,0,2"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="ColsSlider" Grid.Column="0" Minimum="20" Maximum="240" Value="160"
                                    TickFrequency="10" IsSnapToTickEnabled="True"
                                    ValueChanged="PreviewSetting_Changed"/>
                            <TextBlock x:Name="ColsLabel" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Margin="4,0"/>
                        </Grid>

                        <TextBlock Text="解像度 rows" Foreground="#CCC" Margin="0,0,0,2"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="RowsSlider" Grid.Column="0" Minimum="12" Maximum="135" Value="90"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="PreviewSetting_Changed"/>
                            <TextBlock x:Name="RowsLabel" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Margin="4,0"/>
                        </Grid>

                        <CheckBox x:Name="EdgeCheck" Content="エッジのみ（--edge）" Foreground="White" Margin="0,0,0,4"
                                  Checked="PreviewSetting_Changed" Unchecked="PreviewSetting_Changed"/>
                        <TextBlock Text="エッジ検出の強さ" Foreground="#CCC" Margin="0,0,0,2"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="EdgeStrengthSlider" Grid.Column="0" Minimum="25" Maximum="200" Value="100"
                                    ValueChanged="PreviewSetting_Changed"/>
                            <TextBlock x:Name="EdgeStrengthLabel" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Margin="4,0"/>
                        </Grid>

                        <CheckBox x:Name="ColorCheck" Content="カラー表示（生成にも反映）" Foreground="White" Margin="0,0,0,4"
                                  IsChecked="True" Checked="PreviewSetting_Changed" Unchecked="PreviewSetting_Changed"/>
                        <TextBlock Foreground="#777" FontSize="10" Margin="0,0,0,10"
                                   Text="OFF にすると生成・表示ともモノクロになります。"/>

                        <TextBlock Text="表示フォントサイズ" Foreground="#CCC" Margin="0,0,0,2"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="FontSizeSlider" Grid.Column="0" Minimum="6" Maximum="24" Value="12"
                                    ValueChanged="PreviewSetting_Changed"/>
                            <TextBlock x:Name="FontSizeLabel" Grid.Column="1" Foreground="White" VerticalAlignment="Center" Margin="4,0"/>
                        </Grid>

                        <TextBlock Text="表示フォント（等幅）" Foreground="#CCC" Margin="0,8,0,2"/>
                        <ComboBox x:Name="FontFamilyCombo"
                                  Foreground="White"
                                  Background="#222"
                                  SelectionChanged="PreviewSetting_Changed">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="Background" Value="White"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBoxItem Content="Consolas" IsSelected="True"/>
                            <ComboBoxItem Content="Cascadia Mono"/>
                            <ComboBoxItem Content="Lucida Console"/>
                            <ComboBoxItem Content="Courier New"/>
                            <ComboBoxItem Content="MS Gothic"/>
                        </ComboBox>

                        <TextBlock Text="音量" Foreground="#CCC" Margin="0,10,0,2"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="52"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="MuteButton"
                                    Grid.Column="0"
                                    Content="ミュート"
                                    Margin="0,0,8,0"
                                    Click="MuteButton_Click"/>
                            <Slider x:Name="VolumeSlider"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="0.8"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="False"
                                    VerticalAlignment="Center"
                                    ValueChanged="VolumeSlider_ValueChanged"/>
                            <TextBlock x:Name="VolumeLabel"
                                       Grid.Column="2"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Foreground="White"/>
                        </Grid>

                        <TextBlock Foreground="#666" FontSize="10" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Text="mp4 を開いたときは元動画から再生成表示、.amov を開いたときは保存フレームを表示します。"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Margin="8,4,8,8">
            <Slider x:Name="SeekSlider"
                    Minimum="0"
                    Maximum="0"
                    Value="0"
                    PreviewMouseDown="SeekSlider_PreviewMouseDown"
                    PreviewMouseUp="SeekSlider_PreviewMouseUp"
                    ValueChanged="SeekSlider_ValueChanged"/>
            <TextBlock x:Name="TimeLabel" Foreground="White" HorizontalAlignment="Center"/>
        </StackPanel>

        <MediaElement x:Name="AudioPlayer" Visibility="Collapsed"/>
    </Grid>
</Window>
